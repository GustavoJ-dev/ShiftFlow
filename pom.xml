<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.gestaoescalas</groupId>
    <artifactId>shift-flow</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <packaging>pom</packaging>

    <name>ShiftFlow</name>

    <description>
        API REST para gerenciamento de escalas corporativas, turnos e
        solicitações de troca entre colaboradores, desenvolvida com
        arquitetura de microsserviços.
    </description>

    <url>https://github.com/GustavoJ-dev/ShiftFlow</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit/</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Gustavo de Jesus Silva</name>
            <email>gustavo.jesus.silva.dev@gmail.com</email>
            <organization>GustavoJ-dev</organization>
            <organizationUrl>https://gustavoj.com.br</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/GustavoJ-dev/ShiftFlow.git</connection>
        <developerConnection>scm:git:ssh://github.com/GustavoJ-dev/ShiftFlow.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/GustavoJ-dev/ShiftFlow</url>
    </scm>

    <modules>
        <module>auth-service</module>
        <module>schedule-service</module>
        <module>notification-service</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Versões de dependências externas -->
        <springdoc.version>3.0.0</springdoc.version>
    </properties>

</project>
